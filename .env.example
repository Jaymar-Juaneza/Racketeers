# Copy this file to `.env.local` (or `.env`) and fill in real values.
# NEVER commit the real file to version control.

# --- Supabase (required before any backend integration) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel (required before deployment configuration) ---
VERCEL_PROJECT_NAME=
VERCEL_TEAM_NAME=

# --- App secrets ---
# Optional: override the static organizer password (defaults to the value in
# src/lib/auth/staticAuth.js when left empty).
VITE_ORGANIZER_PASSWORD=
