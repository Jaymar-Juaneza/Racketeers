# Copy this file to `.env` if you need to override the defaults.
# NEVER commit the real file to version control.
#
# The Firebase web config already ships with working defaults for the
# "rocketeers-5ad3d" project in src/lib/firebase.js, so this file is optional.

# --- Firebase (web config overrides) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Vercel (optional, for deployment) ---
VERCEL_PROJECT_NAME=
VERCEL_TEAM_NAME=
